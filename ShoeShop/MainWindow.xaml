<Window x:Class="ShoeShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeShop"
        mc:Ignorable="d"        
        Title="Чудо Обувь" Height="450" Width="800" Icon="/Image/Чудо Обувь.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="69*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#D2F6E7"/>
        <Grid Grid.Row="2" Background="#D2F6E7"/>
        <Image Source="/Image/Чудо Обувь.png" Width="100" HorizontalAlignment="Left"/>
        <TextBlock FontFamily="Calibri" FontSize="32" Text="{Binding ElementName=FrameMain, Path=Context.Title}" HorizontalAlignment="Center"/>
        <Button Name="Enter" Content="Авторизация" HorizontalAlignment="Right" FontFamily="Calibri" Background="#70B2AF" Click="Enter_ButtonClick"/>
    </Grid>
</Window>
